# PUIMS environment template — PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local development and replace every CHANGE_ME.

# development | uat | lan | cloud   ("lan" = hospital local server; UI shows "Local server")
PUIMS_DEPLOYMENT_PROFILE=development

# App connects as the least-privileged role (RLS applies). Migrations/seeds use the owner role.
DATABASE_URL=postgres://puims_app:CHANGE_ME@localhost:5432/puims
MIGRATION_DATABASE_URL=postgres://puims_owner:CHANGE_ME@localhost:5432/puims

# Automated tests use a separate database that is wiped and re-seeded.
TEST_DATABASE_URL=postgres://puims_app:CHANGE_ME@localhost:5432/puims_test
TEST_MIGRATION_DATABASE_URL=postgres://puims_owner:CHANGE_ME@localhost:5432/puims_test

# Used ONLY by scripts/db-local-setup.sh to create the roles locally.
PUIMS_DB_OWNER_PASSWORD=CHANGE_ME
PUIMS_DB_APP_PASSWORD=CHANGE_ME

# 32 random bytes, base64. Encrypts TOTP secrets at rest. Generate: openssl rand -base64 32
# Losing it forces every user to re-enrol their authenticator; keep it out of DB backups.
PUIMS_DATA_KEY=CHANGE_ME

# Password given to SYNTHETIC seed accounts (development/uat only; seeding refuses on lan/cloud).
PUIMS_SEED_PASSWORD=CHANGE_ME

# Only for local HTTP testing of production builds. Never set in deployment.
# PUIMS_INSECURE_COOKIES=true

# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
# PUIMS_TRUST_PROXY=true

NEXT_TELEMETRY_DISABLED=1

# Offline capture (Milestone 7). In `lan`/`cloud` profiles the Chief RT cannot approve devices for offline use
# unless this is true — set it only after hospital IT and the DPO approve the offline policy (U-03).
PUIMS_OFFLINE_POLICY_APPROVED=false
