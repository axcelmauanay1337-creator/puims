{
  "name": "puims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=America/Los_Angeles vitest run",
    "test:watch": "TZ=America/Los_Angeles vitest",
    "test:e2e": "playwright test --trace off",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:db && npm run build && npm run test:e2e",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:test": "node --env-file-if-exists=.env.local --import ./scripts/use-test-db.mjs scripts/migrate.mjs",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:seed:test": "tsx --env-file-if-exists=.env.local scripts/seed.ts --test",
    "admin:bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap-chief.ts",
    "dev:totp": "tsx --env-file-if-exists=.env.local scripts/dev-totp.ts",
    "test:db": "TZ=America/Los_Angeles vitest run --config vitest.db.config.mts",
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "predev": "node scripts/predev.mjs && node scripts/build-offline.mjs",
    "fixture:workbook": "tsx scripts/make-synthetic-workbook.ts",
    "build:offline": "node scripts/build-offline.mjs",
    "prebuild": "node scripts/build-offline.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "exceljs": "4.4.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
